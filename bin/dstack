#!/usr/bin/env python3
"""dstack: personal skills + harness config for Claude Code and Codex.

commands:
  sync [source...]        fetch upstream skills into vendor/ and pin them in dstack.lock.json
  install [--dry-run]     link skills/agents/instructions and merge settings into ~/.claude and ~/.codex
  status [--offline]      show what is linked, what drifted, and whether upstream moved
  doctor [--repo-only]    health check; exits 1 when something is wrong
  test [unittest args]    run tests/ with unittest, then `bash -n` and shellcheck on shell scripts
  uninstall [--dry-run]   remove the links dstack owns; merged settings and backups stay

`install` never deletes a file it does not own: anything it replaces goes to
~/.dstack-backups/<timestamp>/. Set DSTACK_HOME to install into another home directory.
status, doctor and test exit non-zero when something is wrong, so they can be scripted.
"""
from __future__ import annotations

import argparse
import copy
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from pathlib import Path
from typing import Callable, Iterable, Iterator, NamedTuple, Optional

MIN_PYTHON = (3, 9)
ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "dstack.json"
LOCK = ROOT / "dstack.lock.json"
VENDOR = ROOT / "vendor"
OWN_SKILLS = ROOT / "skills"
CONFIG = ROOT / "config"
CLAUDE_SETTINGS_SRC = CONFIG / "claude" / "settings.json"
CODEX_HOOKS_SRC = CONFIG / "codex" / "hooks.json"
CODEX_CONFIG_SRC = CONFIG / "codex" / "config.toml"
GIT_TIMEOUT = 20  # seconds, for network git calls in `status`
SKILL_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


class DstackError(Exception):
    """A failure with a message meant for the user; main() prints it without a traceback."""


@dataclass(frozen=True)
class Home:
    """Every path dstack writes under the user's home. Built at runtime so tests can point it elsewhere."""

    root: Path

    @classmethod
    def from_env(cls) -> Home:
        raw = os.environ.get("DSTACK_HOME") or os.environ.get("HOME")
        return cls(Path(raw).expanduser().absolute() if raw else Path.home())

    @property
    def claude(self) -> Path:
        return self.root / ".claude"

    @property
    def codex(self) -> Path:
        return self.root / ".codex"

    @property
    def agents_skills(self) -> Path:  # Codex user skills
        return self.root / ".agents" / "skills"

    @property
    def skill_dirs(self) -> list[Path]:
        return [self.claude / "skills", self.agents_skills]

    @property
    def agent_dir(self) -> Path:
        return self.claude / "agents"

    @property
    def managed_dirs(self) -> list[Path]:
        """Directories where every link into this repo is dstack's to add, replace or prune."""
        return [*self.skill_dirs, self.agent_dir]

    @property
    def backups(self) -> Path:
        return self.root / ".dstack-backups"

    def short(self, path: Path) -> str:
        try:
            return "~/" + str(path.relative_to(self.root))
        except ValueError:
            return str(path)


class Link(NamedTuple):
    at: Path
    target: Path


# ---------------------------------------------------------------- helpers

def say(msg: str = "") -> None:
    print(msg, flush=True)


def load_json(path: Path, default=None):
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        raise DstackError(f"{path} is not valid JSON ({e}); fix it or move it aside, then rerun") from None


def dump_json(data) -> str:
    return json.dumps(data, indent=2) + "\n"


def write_atomic(path: Path, text: str) -> None:
    """Replace a file's content all at once, so a crash never leaves it half written.

    A symlinked file is written through to its target, keeping the link. The file keeps its mode.
    """
    if path.is_symlink():
        path = Path(os.path.realpath(path))
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        mode = stat.S_IMODE(path.stat().st_mode)
    else:
        umask = os.umask(0)
        os.umask(umask)
        mode = 0o666 & ~umask
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise


def git(*args: str, cwd: Optional[Path] = None, timeout: Optional[float] = None) -> str:
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    try:
        proc = subprocess.run(["git", *args], cwd=cwd, env=env, check=True, capture_output=True,
                              text=True, timeout=timeout)
    except FileNotFoundError:
        raise DstackError("git is not installed") from None
    except subprocess.TimeoutExpired:
        raise DstackError(f"`git {' '.join(args)}` timed out after {timeout:.0f}s") from None
    except subprocess.CalledProcessError as e:
        detail = (e.stderr or e.stdout or "").strip().splitlines()
        raise DstackError(f"`git {' '.join(args)}` failed: {detail[-1] if detail else f'exit {e.returncode}'}") from None
    return proc.stdout.strip()


def link_target(link: Path) -> Path:
    """Where a symlink points, as an absolute normalized path. Relative targets resolve against the link's directory."""
    raw = os.readlink(link)
    return Path(os.path.normpath(os.path.join(os.path.realpath(link.parent), raw)))


def is_within(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


def owned(link: Path) -> bool:
    """A link is ours when it points into this repo (by path containment, not string prefix)."""
    if not link.is_symlink():
        return False
    target = link_target(link)
    return is_within(target, ROOT) or is_within(Path(os.path.realpath(target)), ROOT)


def unique_path(path: Path) -> Path:
    """`path`, or `path.1`, `path.2`... whichever does not exist yet, so a backup never overwrites another."""
    candidate, n = path, 0
    while os.path.lexists(candidate):
        n += 1
        candidate = path.with_name(f"{path.name}.{n}")
    return candidate


class Ops:
    """Every filesystem change install/uninstall makes. With dry_run, describes each one instead of doing it."""

    def __init__(self, home: Home, dry_run: bool) -> None:
        self.home = home
        self.dry_run = dry_run
        self.changes = 0
        self.backed_up = False

    def _note(self, msg: str) -> None:
        self.changes += 1
        if self.dry_run:
            say(f"  would {msg}")

    def symlink(self, target: Path, at: Path) -> None:
        self._note(f"link {self.home.short(at)} -> {target}")
        if not self.dry_run:
            at.parent.mkdir(parents=True, exist_ok=True)
            at.symlink_to(target)

    def unlink(self, at: Path, why: str = "remove") -> None:
        self._note(f"{why} {self.home.short(at)} -> {os.readlink(at)}" if at.is_symlink() else f"{why} {at}")
        if not self.dry_run:
            at.unlink()

    def move_to_backup(self, path: Path, dest: Path) -> None:
        dest = unique_path(dest)
        self.backed_up = True
        if self.dry_run:
            self._note(f"back up {self.home.short(path)} -> {self.home.short(dest)}")
            return
        self.changes += 1
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(path), str(dest))
        say(f"  backed up {path} -> {dest}")

    def copy_to_backup(self, path: Path, dest: Path) -> None:
        if not path.exists():
            return
        dest = unique_path(dest)
        self.backed_up = True
        if self.dry_run:
            self._note(f"back up {self.home.short(path)} -> {self.home.short(dest)}")
            return
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dest)

    def write(self, path: Path, text: str, detail: str = "") -> None:
        if self.dry_run:
            self._note(f"update {self.home.short(path)}{detail}")
            return
        self.changes += 1
        write_atomic(path, text)
        say(f"updated {path}")


def backup_dir_for(home: Home, backups: Path, path: Path) -> Path:
    """Backups mirror the home layout: ~/.claude/skills/x goes to <backups>/.claude/skills/x."""
    try:
        return backups / path.parent.relative_to(home.root)
    except ValueError:
        return backups / "other"


# ---------------------------------------------------------------- manifest, lock, skills

def load_manifest() -> dict:
    manifest = load_json(MANIFEST)
    if not isinstance(manifest, dict) or not isinstance(manifest.get("sources"), dict):
        raise DstackError(f"{MANIFEST} is missing or has no `sources` object")
    return manifest


def require_lock() -> dict:
    lock = load_json(LOCK)
    if not lock:
        raise DstackError("no dstack.lock.json; run `bin/dstack sync` first")
    if not isinstance(lock.get("sources"), dict):
        raise DstackError(f"{LOCK} has no `sources` object")
    return lock


def own_skills() -> dict[str, Path]:
    if not OWN_SKILLS.is_dir():
        return {}
    return {p.name: p for p in sorted(OWN_SKILLS.iterdir()) if (p / "SKILL.md").is_file()}


def all_skills(lock: dict) -> dict[str, Path]:
    """Skill name -> directory. The first source listing a name wins; a skill in skills/ beats every source."""
    found: dict[str, Path] = {}
    for name, entry in lock["sources"].items():
        for skill in entry["skills"]:
            found.setdefault(skill, VENDOR / name / "skills" / skill)
    found.update(own_skills())
    return found


def collisions(lock: dict) -> list[tuple[str, str, str]]:
    """(skill, winning source, losing source) for every skill two vendored sources both ship."""
    seen: dict[str, str] = {}
    out = []
    for name, entry in lock["sources"].items():
        for skill in entry["skills"]:
            if skill in seen:
                out.append((skill, seen[skill], name))
            seen.setdefault(skill, name)
    return out


def read_frontmatter(path: Path) -> dict[str, str]:
    """Top-level `key: value` pairs of a SKILL.md YAML frontmatter block. Raises ValueError when there is none."""
    if not path.is_file():
        raise ValueError("SKILL.md is missing")
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    if not lines or lines[0].strip() != "---":
        raise ValueError("SKILL.md does not start with a `---` frontmatter block")
    try:
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration:
        raise ValueError("frontmatter block is not closed with `---`") from None
    fields: dict[str, str] = {}
    key = None
    for line in lines[1:end]:
        m = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if m:
            key, value = m.group(1), m.group(2).strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            fields[key] = "" if value in (">", "|", ">-", "|-") else value
        elif key and line.startswith((" ", "\t")) and line.strip():
            fields[key] = (fields[key] + " " + line.strip()).strip()  # folded/indented continuation
    return fields


def skill_problems(skill: str, path: Path) -> list[str]:
    try:
        fm = read_frontmatter(path / "SKILL.md")
    except ValueError as e:
        return [str(e)]
    problems = []
    if not fm.get("name"):
        problems.append("frontmatter has no `name`")
    elif fm["name"] != skill:
        problems.append(f"frontmatter name `{fm['name']}` does not match directory `{skill}`")
    if not fm.get("description"):
        problems.append("frontmatter has no `description`")
    return problems


def plan_links(home: Home, lock: dict, manifest: dict) -> list[Link]:
    """Every link install makes, in order."""
    links = [Link(d / skill, path) for d in home.skill_dirs for skill, path in all_skills(lock).items()]
    for rel in manifest.get("agents", []):
        src = ROOT / rel
        links.append(Link(home.agent_dir / src.name, src))
    links += [
        Link(home.claude / "CLAUDE.md", ROOT / "global" / "AGENTS.md"),
        Link(home.codex / "AGENTS.md", ROOT / "global" / "AGENTS.md"),
        Link(home.claude / "rules" / "pstack-models.md", ROOT / "global" / "pstack-models.md"),
    ]
    return links


def link_state(link: Link) -> str:
    """ok, missing, broken (ours but the target is gone), or drifted (a file, or a link elsewhere)."""
    if not os.path.lexists(link.at):
        return "missing"
    if link.at.is_symlink() and link_target(link.at) == link.target:
        return "ok" if link.target.exists() else "broken"
    return "drifted"


def stale_links(home: Home, links: list[Link]) -> list[Path]:
    """Links into this repo, in dstack's directories, that install no longer makes."""
    planned = {link.at for link in links}
    out = []
    for d in home.managed_dirs:
        if d.is_dir():
            out += [e for e in sorted(d.iterdir()) if e not in planned and owned(e)]
    return out


# ---------------------------------------------------------------- sync

def safe_join(base: Path, rel: str, what: str) -> Path:
    path = Path(os.path.normpath(base / rel)) if rel else base
    if not is_within(path, base):
        raise DstackError(f"{what} `{rel}` points outside the repository")
    return path


def resolve_skills(name: str, src: dict, root: Path) -> dict[str, str]:
    """Skill name -> path relative to the source root. Raises when a listed skill is missing."""
    spec = src.get("skills", "*")
    if spec == "*":
        skills_dir = root / "skills"
        if not skills_dir.is_dir():
            raise DstackError(f"{name}: `skills: \"*\"` but {src.get('root') or '.'}/skills is not a directory upstream")
        exclude = set(src.get("exclude", []))
        found = {p.name: f"skills/{p.name}" for p in sorted(skills_dir.iterdir())
                 if (p / "SKILL.md").is_file() and p.name not in exclude}
        for skill in sorted(exclude - set(found)):
            say(f"  warning: {name} excludes `{skill}`, which upstream does not have")
    elif isinstance(spec, dict):
        found = dict(spec)
    else:
        raise DstackError(f"{name}: `skills` must be \"*\" or an object of name -> path")
    bad_names = [s for s in found if not SKILL_NAME.fullmatch(s)]
    if bad_names:
        raise DstackError(f"{name}: invalid skill names: {', '.join(bad_names)}")
    missing = [f"{skill} ({rel})" for skill, rel in found.items()
               if not (safe_join(root, rel, f"{name} skill") / "SKILL.md").is_file()]
    if missing:
        raise DstackError(f"{name}: these skills have no SKILL.md upstream: {', '.join(missing)}")
    return found


def stage_source(name: str, src: dict, root: Path, stage: Path) -> list[str]:
    """Copy a source's skills and files into `stage`. Validates everything before copying anything."""
    skills = resolve_skills(name, src, root)
    files = src.get("files", [])
    missing = [rel for rel in files if not os.path.lexists(safe_join(root, rel, f"{name} file"))]
    if missing:
        raise DstackError(f"{name}: these files do not exist upstream: {', '.join(missing)}")
    (stage / "skills").mkdir(parents=True)
    for skill, rel in skills.items():
        shutil.copytree(root / rel, stage / "skills" / skill, symlinks=True)
    for rel in files:
        s, d = root / rel, stage / rel
        d.parent.mkdir(parents=True, exist_ok=True)
        if s.is_dir():
            shutil.copytree(s, d, symlinks=True)
        else:
            shutil.copy2(s, d, follow_symlinks=False)
    return sorted(skills)


def swap_dir(new: Path, dest: Path) -> None:
    """Put `new` at `dest`, keeping the old `dest` until the new one is in place."""
    old = None
    if os.path.lexists(dest):
        old = dest.with_name(f".{dest.name}.old-{os.getpid()}")
        os.rename(dest, old)
    try:
        os.rename(new, dest)
    except BaseException:
        if old is not None:
            os.rename(old, dest)
        raise
    if old is not None:
        shutil.rmtree(old)


def sync(only: list[str]) -> None:
    manifest = load_manifest()
    lock = load_json(LOCK, {"sources": {}})
    unknown = [n for n in only if n not in manifest["sources"]]
    if unknown:
        raise DstackError(f"unknown source(s): {', '.join(unknown)}; dstack.json has {', '.join(manifest['sources'])}")
    selected = {n: s for n, s in manifest["sources"].items() if not only or n in only}
    for name, src in selected.items():
        if not SKILL_NAME.fullmatch(name):
            raise DstackError(f"invalid source name `{name}`")
        for key in ("repo", "ref"):
            if not src.get(key):
                raise DstackError(f"{name}: `{key}` is required in dstack.json")

    VENDOR.mkdir(exist_ok=True)
    clones: dict[tuple[str, str], tuple[Path, str]] = {}
    staged: dict[str, tuple[Path, dict]] = {}
    with tempfile.TemporaryDirectory(prefix="dstack-") as tmp:
        try:
            # Stage every source first: if anything fails, vendor/ and the lock are untouched.
            for name, src in selected.items():
                key = (src["repo"], src["ref"])
                if key not in clones:
                    dest = Path(tmp) / f"clone{len(clones)}"
                    say(f"fetch {src['repo']}@{src['ref']}")
                    git("clone", "--quiet", "--depth", "1", "--branch", src["ref"], src["repo"], str(dest))
                    clones[key] = (dest, git("rev-parse", "HEAD", cwd=dest))
                repo, commit = clones[key]
                root = safe_join(repo, src.get("root", ""), f"{name} root")
                stage = Path(tempfile.mkdtemp(prefix=f".staging-{name}-", dir=VENDOR))
                skills = stage_source(name, src, root, stage)
                staged[name] = (stage, {"repo": src["repo"], "ref": src["ref"], "commit": commit, "skills": skills})

            for name, (stage, entry) in staged.items():
                swap_dir(stage, VENDOR / name)
                old = lock["sources"].get(name, {})
                lock["sources"][name] = entry
                added = sorted(set(entry["skills"]) - set(old.get("skills", [])))
                removed = sorted(set(old.get("skills", [])) - set(entry["skills"]))
                moved = "" if old.get("commit") == entry["commit"] else f" {old.get('commit', 'none')[:7]} -> {entry['commit'][:7]}"
                say(f"  {name}: {len(entry['skills'])} skills{moved}"
                    + (f" +{','.join(added)}" if added and old else "")
                    + (f" -{','.join(removed)}" if removed else ""))
        finally:
            for stage, _ in staged.values():
                if stage.exists():
                    shutil.rmtree(stage)
            for leftover in VENDOR.glob(".staging-*"):
                shutil.rmtree(leftover, ignore_errors=True)

    if not only:  # a full sync also drops sources removed from dstack.json
        for name in sorted(set(lock["sources"]) - set(manifest["sources"])):
            del lock["sources"][name]
            if (VENDOR / name).exists():
                shutil.rmtree(VENDOR / name)
            say(f"  {name}: removed (no longer in dstack.json)")
    lock["sources"] = {n: lock["sources"][n] for n in manifest["sources"] if n in lock["sources"]}
    write_atomic(LOCK, dump_json(lock))
    for skill, winner, loser in collisions(lock):
        say(f"  warning: `{skill}` comes from both {winner} and {loser}; {winner} wins")
    say("done. review with `git diff --stat vendor/`, then `bin/dstack install`.")


# ---------------------------------------------------------------- install

def place_link(link: Link, backups: Path, ops: Ops) -> None:
    at, target = link
    if at.is_symlink() and Path(os.readlink(at)) == target:
        return
    if os.path.lexists(at):
        if owned(at):
            ops.unlink(at, "replace")
        else:
            ops.move_to_backup(at, backup_dir_for(ops.home, backups, at) / at.name)
    ops.symlink(target, at)


def check_link_targets(links: list[Link]) -> None:
    missing = sorted({str(link.target.relative_to(ROOT)) for link in links if not link.target.exists()})
    if missing:
        raise DstackError("these files are missing from the repo (is vendor/ in sync with the lock? "
                          "try `bin/dstack sync`): " + ", ".join(missing))


def install(home: Home, dry_run: bool) -> None:
    lock = require_lock()
    manifest = load_manifest()
    links = plan_links(home, lock, manifest)
    check_link_targets(links)
    managed = managed_configs()  # parse repo config before touching anything
    backups = home.backups / time.strftime("%Y%m%d-%H%M%S")
    ops = Ops(home, dry_run)
    if dry_run:
        say(f"dry run: nothing is written. home: {home.root}")

    adopt_agents_skills(home, backups, ops)
    for stale in stale_links(home, links):  # prune links to skills and agents we no longer ship
        ops.unlink(stale, "prune")
    before = ops.changes
    for link in links:
        place_link(link, backups, ops)
    if not dry_run:
        say(f"linked {len(all_skills(lock))} skills into {', '.join(str(d) for d in home.skill_dirs)}")
        say("linked global instructions, pstack model rule and agents"
            + (f" ({ops.changes - before} links changed)" if ops.changes - before else ""))

    for src_path, path in ((CLAUDE_SETTINGS_SRC, home.claude / "settings.json"),
                           (CODEX_HOOKS_SRC, home.codex / "hooks.json")):
        merge_json(managed[src_path], path, backups, ops)
    merge_codex_config(home, managed[CODEX_CONFIG_SRC], backups, ops)

    if dry_run:
        say(f"dry run: {ops.changes} change(s) would be made" if ops.changes else "dry run: already up to date")
    elif ops.backed_up:
        say(f"backups in {backups}")


def adopt_agents_skills(home: Home, backups: Path, ops: Ops) -> None:
    """One-time: move a skills.sh-managed ~/.agents/skills aside so dstack owns it."""
    lockfile = home.root / ".agents" / ".skill-lock.json"
    if not lockfile.exists():
        return
    dest = backups / ".agents"
    ops.move_to_backup(lockfile, dest / ".skill-lock.json")
    if os.path.lexists(home.agents_skills):
        ops.move_to_backup(home.agents_skills, dest / "skills")
    if not ops.dry_run:
        say(f"moved skills.sh-managed ~/.agents/skills to {dest}")


def deep_merge(base: dict, over: dict) -> dict:
    """Merge `over` into `base` in place. Nested objects merge; everything else, lists included, is replaced."""
    for k, v in over.items():
        base[k] = deep_merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return base


DSTACK_VAR = re.compile(r"\$\{DSTACK\}|\$DSTACK(?![A-Za-z0-9_])")


def expand(obj):
    """Replace $DSTACK (or ${DSTACK}) with this repo's path in every string."""
    if isinstance(obj, str):
        return DSTACK_VAR.sub(lambda _: str(ROOT), obj)
    if isinstance(obj, list):
        return [expand(x) for x in obj]
    if isinstance(obj, dict):
        return {k: expand(v) for k, v in obj.items()}
    return obj


def managed_json(src: Path) -> dict:
    data = load_json(src)
    if not isinstance(data, dict):
        raise DstackError(f"{src} must hold a JSON object")
    data = expand(data)
    data.pop("$comment", None)
    return data


def managed_configs() -> dict:
    return {
        CLAUDE_SETTINGS_SRC: managed_json(CLAUDE_SETTINGS_SRC),
        CODEX_HOOKS_SRC: managed_json(CODEX_HOOKS_SRC),
        CODEX_CONFIG_SRC: parse_flat_toml(CODEX_CONFIG_SRC),
    }


def json_merge_result(managed: dict, path: Path) -> tuple[dict, dict]:
    current = load_json(path, {})
    if not isinstance(current, dict):
        raise DstackError(f"{path} must hold a JSON object")
    return current, deep_merge(copy.deepcopy(current), managed)


def merge_json(managed: dict, path: Path, backups: Path, ops: Ops) -> None:
    """Deep-merge dstack's keys over a JSON file. Lists (e.g. hook arrays) are replaced, not appended."""
    current, merged = json_merge_result(managed, path)
    if merged == current:
        return
    changed = [k for k in merged if current.get(k) != merged[k]]
    ops.copy_to_backup(path, backup_dir_for(ops.home, backups, path) / path.name)
    ops.write(path, dump_json(merged), f" (keys: {', '.join(changed)})")


# ---------------------------------------------------------------- codex config.toml

_BARE = r"[A-Za-z0-9_-]+"
_KEY_PART = rf"(?:{_BARE}|\"(?:[^\"\\]|\\.)*\"|'[^']*')"
_KEY_PATH = rf"{_KEY_PART}(?:\s*\.\s*{_KEY_PART})*"
TOML_KEY = re.compile(rf"^\s*({_KEY_PATH})\s*=")
TOML_TABLE = re.compile(rf"^\s*\[\s*({_KEY_PATH})\s*\]\s*(?:#.*)?$")
TOML_ARRAY_TABLE = re.compile(r"^\s*\[\[")


class TomlKey(NamedTuple):
    table: tuple
    key: tuple
    lines: list


def key_parts(path: str) -> tuple:
    """`a."b.c".d` -> ('a', 'b.c', 'd'), so quoted and bare spellings of a key compare equal."""
    parts = re.findall(_KEY_PART, path)
    out = []
    for p in parts:
        if p.startswith('"'):
            p = json.loads(p)
        elif p.startswith("'"):
            p = p[1:-1]
        out.append(p)
    return tuple(out)


def value_end(lines: list[str], i: int, col: int) -> int:
    """Index just past the last line of the value starting at lines[i][col:] (arrays and strings can span lines)."""
    depth, state = 0, None
    j, k = i, col
    while j < len(lines):
        s = lines[j]
        while k < len(s):
            if state is None:
                if s.startswith('"""', k) or s.startswith("'''", k):
                    state, k = s[k:k + 3], k + 3
                    continue
                c = s[k]
                if c in "\"'":
                    state = c
                elif c in "[{":
                    depth += 1
                elif c in "]}":
                    depth -= 1
                elif c == "#":
                    break
                k += 1
            elif state in ('"', '"""') and s[k] == "\\":
                k += 2
            elif s.startswith(state, k):
                k += len(state)
                state = None
            else:
                k += 1
        if state in ('"', "'"):
            state = None  # a single-line string cannot continue onto the next line
        if state is None and depth <= 0:
            return j + 1
        j, k = j + 1, 0
    return len(lines)


def toml_statements(lines: list[str]) -> Iterator[tuple[int, int, str, Optional[tuple]]]:
    """(start, end, kind, name) for each logical line: kind is table, array-table, key or other."""
    i = 0
    while i < len(lines):
        line = lines[i]
        if TOML_ARRAY_TABLE.match(line):
            yield i, i + 1, "array-table", None
            i += 1
            continue
        m = TOML_TABLE.match(line)
        if m:
            yield i, i + 1, "table", key_parts(m.group(1))
            i += 1
            continue
        m = TOML_KEY.match(line)
        if m:
            end = value_end(lines, i, m.end())
            yield i, end, "key", key_parts(m.group(1))
            i = end
            continue
        yield i, i + 1, "other", None
        i += 1


def parse_flat_toml(path: Path) -> list[TomlKey]:
    """The `key = value` entries of dstack's config.toml, each with its table."""
    lines = path.read_text(encoding="utf-8").splitlines()
    out, table = [], ()
    for start, end, kind, name in toml_statements(lines):
        if kind == "table":
            table = name
        elif kind == "array-table":
            raise DstackError(f"{path}: array tables ([[...]]) are not supported")
        elif kind == "key":
            out.append(TomlKey(table, name, [lines[start].strip(), *lines[start + 1:end]]))
        elif lines[start].strip() and not lines[start].strip().startswith("#"):
            raise DstackError(f"{path}:{start + 1}: cannot parse `{lines[start].strip()}`")
    return out


def table_span(lines: list[str], table: tuple) -> tuple[Optional[int], Optional[int]]:
    """Line range [start, end) of a table's body; the root table is everything before the first header."""
    start = 0 if table == () else None
    for i, _, kind, name in toml_statements(lines):
        if kind in ("table", "array-table"):
            if start is not None:
                return start, i
            if kind == "table" and name == table:
                start = i + 1
    return (start, len(lines)) if start is not None else (None, None)


def table_header(table: tuple) -> str:
    return "[" + ".".join(p if re.fullmatch(_BARE, p) else json.dumps(p) for p in table) + "]"


def merge_toml_lines(lines: list[str], managed: list[TomlKey]) -> list[str]:
    lines = list(lines)
    for table, key, raw in managed:
        start, end = table_span(lines, table)
        if start is None:
            lines += ([""] if lines else []) + [table_header(table), *raw]
            continue
        for s, e, kind, name in toml_statements(lines[start:end]):
            if kind == "key" and name == key:
                lines[start + s:start + e] = raw
                break
        else:
            insert = end
            while insert > start and not lines[insert - 1].strip():
                insert -= 1
            lines[insert:insert] = raw
    return lines


def toml_error(text: str) -> Optional[str]:
    """Why `text` is invalid TOML, when Python can tell (3.11+ ships tomllib)."""
    try:
        import tomllib  # type: ignore[import-not-found]
    except ImportError:
        return None
    try:
        tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        return str(e)
    return None


def codex_config_result(home: Home, managed: list[TomlKey]) -> tuple[Path, list[str], list[str]]:
    path = home.codex / "config.toml"
    lines = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
    return path, lines, merge_toml_lines(lines, managed)


def merge_codex_config(home: Home, managed: list[TomlKey], backups: Path, ops: Ops) -> None:
    """Set dstack's keys in ~/.codex/config.toml without touching anything else.

    Each managed key replaces the same key in the same table (its whole value, even one spanning lines),
    or is appended to that table. Tables that don't exist yet are appended to the file.
    """
    path, original, lines = codex_config_result(home, managed)
    if lines == original:
        return
    text = "\n".join(lines) + "\n"
    err = toml_error(text)
    if err and not toml_error("\n".join(original) + "\n"):
        raise DstackError(f"merging into {path} would make it invalid TOML ({err}); left it unchanged")
    changed = [".".join(m.table + m.key) for m in managed
               if merge_toml_lines(original, [m]) != original]
    ops.copy_to_backup(path, backup_dir_for(home, backups, path) / path.name)
    ops.write(path, text, f" (keys: {', '.join(changed)})")


# ---------------------------------------------------------------- uninstall

def uninstall(home: Home, dry_run: bool) -> None:
    ops = Ops(home, dry_run)
    if dry_run:
        say(f"dry run: nothing is written. home: {home.root}")
    lock = load_json(LOCK, {"sources": {}})
    manifest = load_json(MANIFEST, {"sources": {}})
    candidates = [link.at for link in plan_links(home, lock, manifest)]
    for d in home.managed_dirs:
        if d.is_dir():
            candidates += sorted(d.iterdir())
    seen = set()
    for at in candidates:
        if at not in seen and owned(at):
            ops.unlink(at)
        seen.add(at)
    verb = "would remove" if dry_run else "removed"
    say(f"{verb} {ops.changes} link(s) dstack owned")
    say(f"kept the keys dstack merged into {home.short(home.claude / 'settings.json')}, "
        f"{home.short(home.codex / 'hooks.json')} and {home.short(home.codex / 'config.toml')}; "
        f"hooks and the statusline there still point into {ROOT}")
    if home.backups.is_dir():
        stamps = sorted(p.name for p in home.backups.iterdir() if p.is_dir())
        if stamps:
            say(f"files dstack replaced are in {home.backups} (latest: {stamps[-1]}); restore them by hand if you want")


# ---------------------------------------------------------------- status

def remote_head(repo: str, ref: str) -> Optional[str]:
    """The commit `ref` (a branch or tag) points to upstream, or None when unreachable."""
    try:
        out = git("ls-remote", repo, ref, timeout=GIT_TIMEOUT)
    except DstackError:
        return None
    refs = dict(reversed(line.split("\t", 1)) for line in out.splitlines() if "\t" in line)
    for name in (f"refs/heads/{ref}", f"refs/tags/{ref}^{{}}", f"refs/tags/{ref}"):
        if name in refs:
            return refs[name]
    return None


def remote_heads(lock: dict) -> dict[tuple[str, str], Optional[str]]:
    keys = sorted({(e["repo"], e["ref"]) for e in lock["sources"].values()})
    if not keys:
        return {}
    with ThreadPoolExecutor(max_workers=min(8, len(keys))) as pool:
        return dict(zip(keys, pool.map(lambda k: remote_head(*k), keys)))


def describe_links(label: str, links: list[Link]) -> int:
    """Print one status line for a group of links; return how many are not ok."""
    by_state: dict[str, list[Link]] = {}
    for link in links:
        by_state.setdefault(link_state(link), []).append(link)
    ok = len(by_state.get("ok", []))
    parts = [f"{label}: {ok}/{len(links)} linked"]
    if by_state.get("missing"):
        parts.append("missing " + ", ".join(l.at.name for l in by_state["missing"]))
    if by_state.get("drifted"):
        parts.append("drifted " + ", ".join(
            f"{l.at.name} (-> {os.readlink(l.at)})" if l.at.is_symlink() else f"{l.at.name} (not a link)"
            for l in by_state["drifted"]))
    if by_state.get("broken"):
        parts.append("broken " + ", ".join(l.at.name for l in by_state["broken"]))
    say(", ".join(parts))
    return len(links) - ok


def config_drift(home: Home) -> list[Path]:
    """Config files whose dstack-managed keys differ from the repo."""
    managed = managed_configs()
    out = []
    for src, path in ((CLAUDE_SETTINGS_SRC, home.claude / "settings.json"),
                      (CODEX_HOOKS_SRC, home.codex / "hooks.json")):
        current, merged = json_merge_result(managed[src], path)
        if merged != current:
            out.append(path)
    path, original, merged_lines = codex_config_result(home, managed[CODEX_CONFIG_SRC])
    if merged_lines != original:
        out.append(path)
    return out


def status(home: Home, offline: bool) -> int:
    lock = require_lock()
    manifest = load_manifest()
    links = plan_links(home, lock, manifest)
    problems = 0
    for d in home.skill_dirs:
        problems += describe_links(str(d), [l for l in links if l.at.parent == d])
        if d.is_dir():
            foreign = sorted(e.name for e in d.iterdir() if not owned(e) and not e.name.startswith("."))
            if foreign:
                say(f"  unmanaged: {', '.join(foreign)}")
    problems += describe_links("instructions and agents",
                               [l for l in links if l.at.parent not in home.skill_dirs])
    stale = stale_links(home, links)
    if stale:
        problems += len(stale)
        say("stale links (install prunes them): " + ", ".join(
            home.short(p) + (" (dangling)" if not p.exists() else "") for p in stale))
    drift = config_drift(home)
    if drift:
        problems += len(drift)
        say("config out of sync with the repo: " + ", ".join(home.short(p) for p in drift))
    else:
        say("config: managed keys in sync")

    heads = {} if offline else remote_heads(lock)
    for name, entry in lock["sources"].items():
        if offline:
            state = "upstream not checked"
        else:
            head = heads.get((entry["repo"], entry["ref"]))
            state = ("upstream unreachable" if head is None else
                     "up to date" if head == entry["commit"] else f"upstream moved to {head[:7]}")
        say(f"{name}: {len(entry['skills'])} skills @ {entry['commit'][:7]} ({state})")

    bad = [s for s, p in all_skills(lock).items() if skill_problems(s, p)]
    if bad:
        problems += len(bad)
        say(f"skills with broken frontmatter: {', '.join(bad)}")
    return 1 if problems else 0


# ---------------------------------------------------------------- doctor

class Report:
    def __init__(self) -> None:
        self.failures = 0
        self.warnings = 0

    def ok(self, msg: str) -> None:
        say(f"✓ {msg}")

    def fail(self, msg: str) -> None:
        self.failures += 1
        say(f"✗ {msg}")

    def warn(self, msg: str) -> None:
        self.warnings += 1
        say(f"! {msg}")

    def check(self, problems: list[str], ok_msg: str, limit: int = 12) -> None:
        if not problems:
            self.ok(ok_msg)
            return
        for p in problems[:limit]:
            self.fail(p)
        if len(problems) > limit:
            self.fail(f"...and {len(problems) - limit} more")


def doctor_tools(r: Report) -> None:
    v = sys.version_info
    py = f"python {v.major}.{v.minor}.{v.micro}"
    (r.ok if v[:2] >= MIN_PYTHON else r.fail)(py + ("" if v[:2] >= MIN_PYTHON else f" (need >= {MIN_PYTHON[0]}.{MIN_PYTHON[1]})"))
    for tool, why in (("git", "sync and status need it"), ("jq", "the guard hook and statusline need it")):
        if shutil.which(tool):
            r.ok(f"{tool} found")
        else:
            r.fail(f"{tool} not found ({why})")
    if shutil.which("gh"):
        r.ok("gh found")
    else:
        r.warn("gh not found (optional: the statusline shows the PR number with it)")


def doctor_repo(r: Report) -> Optional[dict]:
    """Lock vs manifest vs vendor/, skills, agents and repo config. Returns the lock when it loaded."""
    try:
        manifest = load_manifest()
        lock = require_lock()
    except DstackError as e:
        r.fail(str(e))
        return None

    problems = []
    for name, src in manifest["sources"].items():
        entry = lock["sources"].get(name)
        if entry is None:
            problems.append(f"source `{name}` is in dstack.json but not in the lock (run `bin/dstack sync {name}`)")
        elif (entry.get("repo"), entry.get("ref")) != (src.get("repo"), src.get("ref")):
            problems.append(f"source `{name}`: lock pins {entry.get('repo')}@{entry.get('ref')}, "
                            f"dstack.json wants {src.get('repo')}@{src.get('ref')} (run `bin/dstack sync {name}`)")
    for name in lock["sources"]:
        if name not in manifest["sources"]:
            problems.append(f"source `{name}` is in the lock but not in dstack.json (run `bin/dstack sync`)")
    r.check(problems, f"lock matches dstack.json ({len(lock['sources'])} sources)")

    problems = []
    for name, entry in lock["sources"].items():
        skills_dir = VENDOR / name / "skills"
        have = {p.name for p in skills_dir.iterdir() if p.is_dir()} if skills_dir.is_dir() else set()
        want = set(entry.get("skills", []))
        if not skills_dir.is_dir():
            problems.append(f"vendor/{name}/skills is missing")
            continue
        if want - have:
            problems.append(f"vendor/{name}: locked skills missing: {', '.join(sorted(want - have))}")
        if have - want:
            problems.append(f"vendor/{name}: skills not in the lock: {', '.join(sorted(have - want))}")
        for rel in manifest["sources"].get(name, {}).get("files", []):
            if not os.path.lexists(VENDOR / name / rel):
                problems.append(f"vendor/{name}/{rel} is missing")
    if VENDOR.is_dir():
        extra = sorted(p.name for p in VENDOR.iterdir() if p.is_dir() and p.name not in lock["sources"])
        if extra:
            problems.append(f"vendor/ has directories no source owns: {', '.join(extra)}")
    total = sum(len(e.get("skills", [])) for e in lock["sources"].values())
    r.check(problems, f"vendor/ matches the lock ({total} skills)")

    skills = all_skills(lock)
    problems = [f"skill `{s}` ({p.relative_to(ROOT)}): {msg}"
                for s, p in skills.items() for msg in skill_problems(s, p)]
    r.check(problems, f"{len(skills)} skills have valid SKILL.md frontmatter")

    problems = [f"skill `{s}` comes from both {w} and {l}; {w} wins" for s, w, l in collisions(lock)]
    overrides = sorted(s for s in own_skills() if any(s in e["skills"] for e in lock["sources"].values()))
    r.check(problems, "skill names are unique" + (f" (skills/ overrides: {', '.join(overrides)})" if overrides else ""))

    problems = [f"agent {rel} is missing" for rel in manifest.get("agents", []) if not (ROOT / rel).is_file()]
    problems += [f"{p.relative_to(ROOT)} is missing" for p in (ROOT / "global" / "AGENTS.md", ROOT / "global" / "pstack-models.md")
                 if not p.is_file()]
    r.check(problems, f"agents and global instructions present ({len(manifest.get('agents', []))} agents)")

    try:
        managed = managed_configs()
    except (DstackError, OSError) as e:
        r.fail(f"repo config: {e}")
        return lock
    r.ok("repo config parses (settings.json, hooks.json, config.toml)")
    scripts = sorted({Path(m.group(0)) for s in json_commands([managed[CLAUDE_SETTINGS_SRC], managed[CODEX_HOOKS_SRC]]) for m in re.finditer(re.escape(str(ROOT)) + r"/\S+", s)})
    problems = [f"{p.relative_to(ROOT)} is referenced by config but " + ("is not executable" if p.exists() else "is missing")
                for p in scripts if not (p.is_file() and os.access(p, os.X_OK))]
    r.check(problems, f"hook and statusline scripts are executable ({len(scripts)})")
    return lock


def json_commands(obj) -> Iterator[str]:
    """Every string under a `command` key (hooks, statusLine) in a JSON config."""
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k == "command" and isinstance(v, str):
                yield v
            else:
                yield from json_commands(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from json_commands(v)


def doctor_home(r: Report, home: Home, lock: dict) -> None:
    links = plan_links(home, lock, load_manifest())
    problems = []
    for link in links:
        state = link_state(link)
        if state == "missing":
            problems.append(f"{home.short(link.at)} is missing (run `bin/dstack install`)")
        elif state == "broken":
            problems.append(f"{home.short(link.at)} -> {link.target} is dangling")
        elif state == "drifted":
            where = f"points to {os.readlink(link.at)}" if link.at.is_symlink() else "is not a link"
            problems.append(f"{home.short(link.at)} {where}, expected {link.target}")
    for p in stale_links(home, links):
        problems.append(f"{home.short(p)} -> {os.readlink(p)} is a stale dstack link"
                        + (" and dangling" if not p.exists() else ""))
    r.check(problems, f"{len(links)} managed links valid in {home.root}")
    try:
        drift = config_drift(home)
    except DstackError as e:
        r.fail(str(e))
        return
    r.check([f"{home.short(p)}: managed keys differ from the repo (run `bin/dstack install`)" for p in drift],
            "managed keys in settings.json, hooks.json and config.toml match the repo")


def doctor(home: Home, repo_only: bool) -> int:
    r = Report()
    doctor_tools(r)
    lock = doctor_repo(r)
    if not repo_only and lock is not None:
        doctor_home(r, home, lock)
    say("")
    if r.failures:
        say(f"{r.failures} problem(s), {r.warnings} warning(s)")
        return 1
    say("all good" + (f" ({r.warnings} warning(s))" if r.warnings else ""))
    return 0


# ---------------------------------------------------------------- test

SHELLCHECK_ARGS = [
    "--severity=warning",
    # guard.sh matches the literal strings "~" and "$HOME" on purpose.
    "--exclude=SC2088",
]


def shell_scripts() -> list[Path]:
    try:
        out = git("ls-files", "-z", "--", "*.sh", cwd=ROOT)
        files = [ROOT / f for f in out.split("\0") if f]
    except DstackError:
        files = [p for p in ROOT.rglob("*.sh") if ".git" not in p.relative_to(ROOT).parts]
    return sorted(p for p in files if p.is_file())


def run_tests(args: list[str]) -> int:
    failed = []
    say(f"$ python -m unittest discover -s tests {' '.join(args)}".rstrip())
    if subprocess.call([sys.executable, "-m", "unittest", "discover", "-s", "tests", *args], cwd=ROOT):
        failed.append("unittest")

    scripts = shell_scripts()
    bad = [p for p in scripts if subprocess.call(["bash", "-n", str(p)])]
    say(f"bash -n: {len(scripts) - len(bad)}/{len(scripts)} scripts parse")
    if bad:
        failed.append("bash -n " + " ".join(str(p.relative_to(ROOT)) for p in bad))

    ours = [p for p in scripts if not is_within(p, VENDOR)]  # vendor/ is upstream's code
    if not shutil.which("shellcheck"):
        say("shellcheck: not installed, skipped")
    elif ours:
        rc = subprocess.call(["shellcheck", *SHELLCHECK_ARGS, *map(str, ours)], cwd=ROOT)
        say(f"shellcheck: {'ok' if rc == 0 else 'failed'} ({len(ours)} scripts outside vendor/)")
        if rc:
            failed.append("shellcheck")
    if failed:
        say("FAILED: " + "; ".join(failed))
        return 1
    say("all checks passed")
    return 0


# ---------------------------------------------------------------- main

def build_parser() -> argparse.ArgumentParser:
    doc = (__doc__ or "").strip()
    p = argparse.ArgumentParser(prog="dstack", description=doc.splitlines()[0],
                                epilog=doc.split("\n\n")[-1],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", metavar="<command>")
    s = sub.add_parser("sync", help="fetch upstream skills into vendor/ and update the lock")
    s.add_argument("sources", nargs="*", help="only these sources from dstack.json (default: all)")
    s = sub.add_parser("install", help="link skills, agents and instructions, then merge config")
    s.add_argument("--dry-run", action="store_true", help="print every change, write nothing")
    s = sub.add_parser("status", help="what is linked, what drifted, whether upstream moved")
    s.add_argument("--offline", action="store_true", help="skip checking upstream with git ls-remote")
    s = sub.add_parser("doctor", help="health check; exits 1 on failure")
    s.add_argument("--repo-only", action="store_true",
                   help="check only the repo (lock, vendor/, skills, config), not the home directory")
    sub.add_parser("test", add_help=False, help="run tests/, `bash -n` and shellcheck; extra args go to unittest")
    s = sub.add_parser("uninstall", help="remove the links dstack owns (keeps merged settings)")
    s.add_argument("--dry-run", action="store_true", help="print what would be removed, write nothing")
    sub.add_parser("help", help="show this help")
    return p


def main(argv: Optional[list[str]] = None) -> int:
    if sys.version_info[:2] < MIN_PYTHON:
        sys.exit(f"dstack needs python >= {MIN_PYTHON[0]}.{MIN_PYTHON[1]}")
    argv = sys.argv[1:] if argv is None else argv
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(errors="replace")  # ✓/✗ on a non-UTF-8 terminal
    parser = build_parser()
    args, extra = parser.parse_known_args(argv)
    if args.cmd != "test" and extra:
        parser.error(f"unrecognized arguments: {' '.join(extra)}")
    if args.cmd in (None, "help"):
        parser.print_help()
        return 0
    home = Home.from_env()
    try:
        if args.cmd == "sync":
            sync(args.sources)
        elif args.cmd == "install":
            install(home, args.dry_run)
        elif args.cmd == "status":
            return status(home, args.offline)
        elif args.cmd == "doctor":
            return doctor(home, args.repo_only)
        elif args.cmd == "test":
            return run_tests(extra)
        elif args.cmd == "uninstall":
            uninstall(home, args.dry_run)
    except DstackError as e:
        print(f"dstack: {e}", file=sys.stderr)
        return 1
    except BrokenPipeError:  # e.g. `dstack status | head`
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
